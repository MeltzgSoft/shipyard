;; Source paths are NOT configured here. With :deps, shadow-cljs takes them from
;; the deps.edn :cljs alias (:extra-paths ["src/cljs" "src/cljc"]) and ignores
;; any :source-paths set in this file.
{:deps   {:aliases [:cljs]}
 :builds {;; The cljc tests run here as well as on the JVM. That cross-runtime
          ;; run is what proves encoder and decoder agree on the binary layout.
          :test
          {:target     :node-test
           :output-to  "target/js/node-tests.js"
           :ns-regexp  "shipyard\\..*-test$"}

          :viewport
          {:target     :browser
           :output-dir "resources/public/js"
           :asset-path "/js"
           :modules    {:workspace {:init-fn shipyard.workspace/init}
                        :viewport {:init-fn shipyard.viewport/init :depends-on #{:workspace}}}
           ;; The E2E suite reads window.__shipyard.stats() rather than pixels
           ;; (TECHNICAL.md §10.3), so a dev build carries the hook and a
           ;; release build constant-folds it away. `clojure -T:build uber`
           ;; asserts it is really gone.
           :dev        {:closure-defines {shipyard.viewport/TEST-HOOKS true}}
           :release    {:compiler-options {:optimizations :advanced}}}}}
