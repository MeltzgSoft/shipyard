;; Shipyard system configuration.
;;
;; Resolution order, later winning over earlier (see shipyard.system/load-config):
;;   1. this file, shipped in the jar
;;   2. $XDG_CONFIG_HOME/shipyard/config.edn   - system overrides, deep-merged
;;   3. environment variables               - PORT
;; Application settings are read from Datalevin after this opens the store.
;;
;; Mesh tunables were measured (TECHNICAL.md §6.2, §6.3, §6.5); job bounds limit
;; concurrent memory use. All are adjustable without a rebuild.

{;; Component keys are namespaced to the namespace that implements them, so
 ;; integrant's load-namespaces can find each ig/init-key without a registry.

 ;; No default, deliberately. Every other value in this file is a measured
 ;; tunable; this one is a fact about the user's machine, and the only honest
 ;; default is to admit we do not know it and ask. Set from the settings form,
 ;; which writes to the shared database - see shipyard.http.settings.
 :shipyard.library/index
 {:root nil :store #ig/ref :shipyard.store/db}

 :shipyard.mesh/cache
 {:crease-deg 35                  ; §6.2 - shading quality knob; V/T moves only ~15% over 15-60°
  :lod-tiers  [1.0 0.25 0.05]     ; §6.3 - never below ~8%, crease-split meshes floor at 3.05%
  :facet-angle-deg 1.0            ; §12.2 - coplanar facet growth
  :facet-plane-epsilon-mm 0.01    ; §12.2 - exporter-noise tolerance
  :cap-bytes  #profile {:default 4294967296   ; 4 GB
                        :test    67108864}}   ; 64 MB so LRU eviction is testable in seconds

 :shipyard.store/db {}
 ;; One executor for library/import preprocessing, recovery and all thumbnails.
 ;; Depend on the store so all workers stop before its native handle closes.
 :shipyard.jobs/pool {:store #ig/ref :shipyard.store/db :threads 2 :queue-size 128}
 :shipyard.file-picker/db {}
 :shipyard.thumbnail/cache {:cache #ig/ref :shipyard.mesh/cache :cap-bytes 134217728
                            :workers #ig/ref :shipyard.jobs/pool}

 :shipyard.catalog/db
 {:library #ig/ref :shipyard.library/index
  :store #ig/ref :shipyard.store/db}

 ;; Preprocessing runs here rather than on the Jetty thread: a cold hull takes
 ;; seconds and GET /part/:id must return immediately (TECHNICAL.md §7).
 :shipyard.http/jobs
 {:library #ig/ref :shipyard.library/index
  :workers #ig/ref :shipyard.jobs/pool
  :cache   #ig/ref :shipyard.mesh/cache}

 :shipyard.assembly/db {}

 :shipyard.loadout/db {:store #ig/ref :shipyard.store/db :catalog #ig/ref :shipyard.catalog/db}
 :shipyard.scheme/db {:store #ig/ref :shipyard.store/db :catalog #ig/ref :shipyard.catalog/db}
 :shipyard.ship/db {:store #ig/ref :shipyard.store/db :catalog #ig/ref :shipyard.catalog/db}
 :shipyard.paint/db {:paint/flush-interval-ms 120 :preview #ig/ref :shipyard.loadout.operations/preview}
 :shipyard.loadout.operations/preview {}
 :shipyard.workspace/db {}

 :shipyard.http/routes
 {:thumbnails #ig/ref :shipyard.thumbnail/cache
  :file-picker #ig/ref :shipyard.file-picker/db
  :library #ig/ref :shipyard.library/index
  :catalog #ig/ref :shipyard.catalog/db
  :cache   #ig/ref :shipyard.mesh/cache
  :jobs    #ig/ref :shipyard.http/jobs
  :assembly #ig/ref :shipyard.assembly/db
  :loadouts #ig/ref :shipyard.loadout/db
  :schemes #ig/ref :shipyard.scheme/db
  :named-ships #ig/ref :shipyard.ship/db
  :paint #ig/ref :shipyard.paint/db
  :preview #ig/ref :shipyard.loadout.operations/preview
  :workspace #ig/ref :shipyard.workspace/db}

 :shipyard.http/server
 {:port    #or [#env PORT 8080]
  :host    "127.0.0.1"
  :handler #ig/ref :shipyard.http/routes}}
