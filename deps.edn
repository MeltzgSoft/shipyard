{:paths ["src/clj" "src/cljc" "resources"]

 :deps
 {org.clojure/clojure            {:mvn/version "1.12.4"}
  metosin/reitit-ring            {:mvn/version "0.7.2"}
  ring/ring-jetty-adapter        {:mvn/version "1.12.2"}
  hiccup/hiccup                  {:mvn/version "2.0.0-RC3"}
  ;; One header needs JSON: htmx parses `HX-Trigger` itself and dispatches a
  ;; key per event, so the envelope is not ours to choose (TECHNICAL.md §7.1).
  ;; The payload inside it is EDN.
  org.clojure/data.json          {:mvn/version "2.5.1"}
  datascript/datascript          {:mvn/version "1.7.3"}
  integrant/integrant            {:mvn/version "1.0.1"}
  aero/aero                      {:mvn/version "1.1.6"}
  org.clojure/tools.logging      {:mvn/version "1.3.0"}
  ;; Filesystem work as Clojure rather than java.nio interop, and it normalises
  ;; path separators - the class of bug that broke the reflection guard on
  ;; Windows.
  babashka/fs                    {:mvn/version "0.5.34"}
  ;; sha256 of a file, streamed. Replaces a hand-rolled MessageDigest loop.
  digest/digest                  {:mvn/version "1.4.10"}
  ch.qos.logback/logback-classic {:mvn/version "1.5.13"}
  org.lwjgl/lwjgl                {:mvn/version "3.3.6"}
  org.lwjgl/lwjgl-meshoptimizer  {:mvn/version "3.3.6"}}

 :aliases
 {;; --- platform natives (LWJGL needs core + module for each platform) -----
  :natives-linux
  {:extra-deps {org.lwjgl/lwjgl$natives-linux               {:mvn/version "3.3.6"}
                org.lwjgl/lwjgl-meshoptimizer$natives-linux {:mvn/version "3.3.6"}}}
  :natives-windows
  {:extra-deps {org.lwjgl/lwjgl$natives-windows               {:mvn/version "3.3.6"}
                org.lwjgl/lwjgl-meshoptimizer$natives-windows {:mvn/version "3.3.6"}}}
  :natives-macos
  {:extra-deps {org.lwjgl/lwjgl$natives-macos               {:mvn/version "3.3.6"}
                org.lwjgl/lwjgl-meshoptimizer$natives-macos {:mvn/version "3.3.6"}}}
  :natives-macos-arm64
  {:extra-deps {org.lwjgl/lwjgl$natives-macos-arm64               {:mvn/version "3.3.6"}
                org.lwjgl/lwjgl-meshoptimizer$natives-macos-arm64 {:mvn/version "3.3.6"}}}

  ;; --- run ----------------------------------------------------------------
  :run
  {:main-opts  ["-m" "shipyard.main"]
   :jvm-opts   ["--enable-native-access=ALL-UNNAMED"
                "--sun-misc-unsafe-memory-access=allow"]}

  ;; --- test ---------------------------------------------------------------
  :test
  {:extra-paths ["test/clj" "test/cljc"]
   ;; Playwright rather than a WebDriver client: it ships the browser it drives,
   ;; versioned with the library, so the E2E level needs no system Chrome and no
   ;; separately-matched chromedriver (issue #49). `playwright install chromium`
   ;; fetches it.
   :extra-deps  {lambdaisland/kaocha            {:mvn/version "1.91.1392"}
                 com.microsoft.playwright/playwright {:mvn/version "1.62.0"}}
   :jvm-opts    ["--enable-native-access=ALL-UNNAMED"
                 "--sun-misc-unsafe-memory-access=allow"]
   :main-opts   ["-m" "kaocha.runner"]}

  ;; --- cljs ---------------------------------------------------------------
  :cljs
  {:extra-paths ["src/cljs" "src/cljc" "test/cljc"]
   :extra-deps  {thheller/shadow-cljs {:mvn/version "3.4.12"}}}

  ;; --- canary (issue #18) --------------------------------------------------
  :canary
  {:main-opts ["-m" "shipyard.canary"]
   :jvm-opts  ["--enable-native-access=ALL-UNNAMED"
               "--sun-misc-unsafe-memory-access=allow"]}

  ;; --- M1 performance benchmark (issue #44) -------------------------------
  ;; Deliberately on-demand, like the canary: wall-clock and viewport figures
  ;; are machine-dependent and would be flaky as CI gates. The 1 GB ceiling is
  ;; part of the measurement, not merely a launcher preference.
  :benchmark
  {:extra-deps {com.microsoft.playwright/playwright {:mvn/version "1.62.0"}}
   :main-opts  ["-m" "shipyard.benchmark"]
   :jvm-opts   ["--enable-native-access=ALL-UNNAMED"
                "--sun-misc-unsafe-memory-access=allow"
                "-Xmx1g"]}

  ;; --- dependency freshness ------------------------------------------------
  ;; `clojure -M:outdated` reports newer versions for deps.edn AND package.json,
  ;; which matters here because three.js and htmx are pinned in npm rather than
  ;; Maven (TECHNICAL.md §8).
  :outdated
  {:deps      {com.github.liquidz/antq {:mvn/version "2.11.1276"}}
   :main-opts ["-m" "antq.core"]}

  ;; --- formatting -----------------------------------------------------------
  ;; `clojure -M:cljfmt check` / `clojure -M:cljfmt fix`.
  ;; src/cljs and the test roots are added because neither is on the default
  ;; :paths - cljs is compiled by shadow, not the JVM.
  :cljfmt
  {:extra-paths ["src/cljs" "test/clj" "test/cljc"]
   :extra-deps  {dev.weavejester/cljfmt {:mvn/version "0.16.5"}}
   :main-opts   ["-m" "cljfmt.main"]}

  ;; --- linting --------------------------------------------------------------
  ;; `clojure -M:clj-kondo --lint src test build.clj`. Same path reasoning as
  ;; :cljfmt above.
  :clj-kondo
  {:extra-paths ["src/cljs" "test/clj" "test/cljc"]
   :extra-deps  {clj-kondo/clj-kondo {:mvn/version "2026.08.04"}}
   :main-opts   ["-m" "clj-kondo.main"]}

  ;; --- build --------------------------------------------------------------
  :build
  {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.5"}}
   :ns-default build}}}
